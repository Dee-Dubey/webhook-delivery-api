{
  "name": "webhook-delivery-api-sequelize",
  "version": "1.0.0",
  "description": "Reliable webhook delivery API (Express + Sequelize + MySQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "db:create": "sequelize-cli db:create",
    "migrate": "sequelize-cli db:create && sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo:all",
    "test": "jest --runInBand --forceExit"
  },
  "engines": { "node": ">=18.2" },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0"
  }
}
